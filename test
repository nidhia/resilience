import cmath


def solve_quadratic(a, b, c):
    """Solve ax^2 + bx + c = 0 and return its roots as a tuple.

    Returns real roots when the discriminant is non-negative and complex
    roots otherwise. If a == 0 the equation is linear, so a single root is
    returned, and if the equation has no variable term an empty tuple is
    returned.
    """
    if a == 0:
        if b == 0:
            return ()
        return (-c / b,)

    discriminant = b * b - 4 * a * c
    sqrt_d = cmath.sqrt(discriminant)

    if discriminant.real >= 0 and discriminant.imag == 0:
        sqrt_d = sqrt_d.real
        # Use the numerically stable form to avoid cancellation.
        q = -0.5 * (b + sqrt_d if b >= 0 else b - sqrt_d)
        if q == 0:
            return (0.0,) if discriminant == 0 else (0.0, 0.0)
        return tuple(sorted((q / a, c / q)))

    x1 = (-b + sqrt_d) / (2 * a)
    x2 = (-b - sqrt_d) / (2 * a)
    return (x1, x2)


if __name__ == "__main__":
    print(solve_quadratic(1, -3, 2))   # (1.0, 2.0)
    print(solve_quadratic(1, 2, 1))    # (-1.0, -1.0)
    print(solve_quadratic(1, 0, 1))    # (1j, -1j)
    print(solve_quadratic(0, 2, -4))   # (2.0,)
